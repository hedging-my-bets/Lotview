modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "chromium", "cups", "dbus", "expat", "freetype", "gdk-pixbuf", "glib", "gtk3", "lcms2", "libdrm", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libxkbcommon", "mesa", "nspr", "nss", "openjpeg", "pango", "tcl", "tk", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "zip", "zlib"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5432
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 34881
externalPort = 6800

[[ports]]
localPort = 36059
externalPort = 3000

[[ports]]
localPort = 36979
externalPort = 4200

[[ports]]
localPort = 38125
externalPort = 8099

[[ports]]
localPort = 38689
externalPort = 8000

[[ports]]
localPort = 38933
externalPort = 8008

[[ports]]
localPort = 39707
externalPort = 6000

[[ports]]
localPort = 40499
externalPort = 8080

[[ports]]
localPort = 43241
externalPort = 8081

[[ports]]
localPort = 43303
externalPort = 5173

[[ports]]
localPort = 44471
externalPort = 3003

[[ports]]
localPort = 45459
externalPort = 3002

[[ports]]
localPort = 45949
externalPort = 5000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
mockupState = "FULLSTACK"
integrations = ["javascript_database:1.0.0", "javascript_openai_ai_integrations:1.0.0", "javascript_object_storage:1.0.0"]

[userenv]

[userenv.shared]
FACEBOOK_APP_ID = "YOUR_FACEBOOK_APP_ID"
FACEBOOK_APP_SECRET = "YOUR_FACEBOOK_APP_SECRET"
FACEBOOK_REDIRECT_URI = "YOUR_REDIRECT_URI"
SCHEDULER_ENABLED = "true"
